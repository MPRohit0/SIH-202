{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeline.schema.json",
  "title": "Timeline (contract §5.5)",
  "description": "Flood-front frames (median/HIGH/POSSIBLE, extent at time t = cells whose arrival <= t), the M2 inflow hydrograph(s), and arrival time vs chainage along the centreline with P10/P50/P90 bounds.",
  "type": "object",
  "required": [
    "query_id",
    "interval_s",
    "t_end_s",
    "frames",
    "hydrographs",
    "arrival_profile",
    "pois_on_profile",
    "caveats",
    "provenance"
  ],
  "properties": {
    "query_id": {
      "type": "string"
    },
    "interval_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "t_end_s": {
      "description": "The run's simulation end time; the last frame's t_s never exceeds this.",
      "type": "number",
      "minimum": 0
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t_s",
          "median_url",
          "high_url",
          "possible_url",
          "bounds_latlng"
        ],
        "properties": {
          "t_s": {
            "type": "number"
          },
          "median_url": {
            "type": "string"
          },
          "high_url": {
            "type": "string"
          },
          "possible_url": {
            "type": "string"
          },
          "bounds_latlng": {
            "type": "array"
          }
        }
      }
    },
    "hydrographs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dam_id",
          "t_offset_s",
          "points"
        ],
        "properties": {
          "dam_id": {
            "type": "string"
          },
          "t_offset_s": {
            "type": "number"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "t_s",
                "q_m3s"
              ],
              "properties": {
                "t_s": {
                  "type": "number"
                },
                "q_m3s": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "arrival_profile": {
      "description": "One row per sampled chainage. arrival_p10_s/arrival_p90_s are null where that percentile never arrives within t_end_s. Rows where even the median never arrives are omitted.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chainage_m",
          "arrival_p10_s",
          "arrival_p50_s",
          "arrival_p90_s"
        ],
        "properties": {
          "chainage_m": {
            "type": "number"
          },
          "arrival_p10_s": {
            "type": ["number", "null"]
          },
          "arrival_p50_s": {
            "type": "number"
          },
          "arrival_p90_s": {
            "type": ["number", "null"]
          }
        }
      }
    },
    "pois_on_profile": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "poi_id",
          "name",
          "chainage_m"
        ],
        "properties": {
          "poi_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "chainage_m": {
            "type": "number"
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Caveat" }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/Provenance" }
  }
}
