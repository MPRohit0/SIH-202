{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geojson_feature_collection.schema.json",
  "title": "GeoJSON FeatureCollection, EPSG:4326 lon/lat (contract \u00a71.3)",
  "type": "object",
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": [
              "object",
              "null"
            ]
          },
          "properties": {
            "type": "object"
          }
        }
      }
    }
  }
}
