# design/target-state-preview: preview is the default data mode on this
# branch for both `npm run dev` (this file) and `npm run build` (.env.production).
# Set VITE_DATA_MODE=live in your shell (or a personal .env.local, which Vite
# loads after this file and git ignores) to run against the real backend/mocks
# instead -- see src/data/source.ts's isPreviewMode().
VITE_DATA_MODE=preview
