*.log

# backend/m3_pilot/inputs/make_export.py output: large, regenerable point clouds (derived from
# data/, which is itself gitignored) -- not the hand-written pilot scripts, which ARE committed.
backend/m3_pilot/inputs/export/

# ANUGA run output (.sww/.npz): large, regenerable from the committed pilot scripts -- not the
# scripts or their small input files (.xyz/.pol/.tim), which ARE committed.
backend/m3_pilot/**/*.sww
backend/m3_pilot/**/*.npz

# D-Flow FM pilot/reproduction results: keep locally for review, but regenerate the large binary
# map/history products and kernel working files from the committed case inputs and run metadata.
m3_pilot/**/*_map.nc
m3_pilot/**/*_his.nc
m3_pilot/**/max_face_summary.csv
m3_pilot/**/*.cache
m3_pilot/**/kernel.pid
m3_pilot/**/unstruc.dia

